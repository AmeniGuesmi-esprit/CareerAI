# Copier ce fichier vers `.env` (ignoré par git) puis remplir les valeurs.
# Aucune valeur secrète par défaut n'est définie dans les fichiers de configuration :
# une variable manquante fait échouer le démarrage au lieu d'utiliser un mot de passe faible.

# ---- Authentification (même secret pour user-service et api-gateway, Base64) ----
# Générer : [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=

# ---- Gmail (SMTP) : mot de passe d'application de 16 caractères ----
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Compte administrateur créé au premier démarrage ----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Base MySQL (XAMPP en local, service mysql en Docker) ----
DB_USER=root
DB_PASSWORD=

# ---- Eureka ----
EUREKA_USER=admin
EUREKA_PASSWORD=admin123

# ---- Compatibility-service (Claude). Laisser vide pour désactiver l'analyse CV/offre ----
ANTHROPIC_API_KEY=

# ---- Interview-service : Ollama tourne dans Docker Compose (service "ollama") ----
# Ne pas modifier pour un lancement via docker compose. Pour un lancement local (mvn), utiliser http://localhost:11434.
OLLAMA_BASE_URL=http://ollama:11434
