# Copiez ce fichier en .env (ignoré par Git) et remplissez les valeurs.
# Inutile si ces variables existent déjà dans les variables d'environnement de votre PC.

# Secret JWT en Base64, identique pour tous les services (32 octets minimum).
# Générer sous PowerShell :
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=

# Clé API Groq (https://console.groq.com/keys), utilisée par skill-gap-service
LLM_API_KEY=

# Gmail : adresse et mot de passe d'application de 16 caractères (pas le mot de passe du compte)
MAIL_USERNAME=
MAIL_PASSWORD=

# Compte administrateur créé au premier démarrage de user-service
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ----- Optionnel (valeurs par défaut entre parenthèses) -----
# EUREKA_USER=            (admin)
# EUREKA_PASSWORD=        (admin123)
# LLM_MODEL=              (openai/gpt-oss-120b)
# LLM_REASONING_EFFORT=   (low)
# HF_API_KEY=             (vide : recherche RAG lexicale locale)
# OLLAMA_MODEL=           (qwen2.5:7b)
